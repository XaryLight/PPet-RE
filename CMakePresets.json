{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "stub",
      "displayName": "Release + Cubism 桩（默认）",
      "description": "无需 Cubism SDK，用仓库内置 Core 桩验证 UI 与构建链路。日常开发首选。",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PPET_WITH_CUBISM": "OFF",
        "PPET_WITH_CUBISM_STUB": "ON",
        "PPET_CUBISM_AUTODETECT": "OFF"
      }
    },
    {
      "name": "cubism",
      "displayName": "Release + 真实 Cubism SDK",
      "description": "需先把 Cubism Core 解压到 api/live2d/csdk/，否则 configure 阶段会给出友好提示并失败。",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PPET_WITH_CUBISM": "ON",
        "PPET_WITH_CUBISM_STUB": "OFF",
        "PPET_CUBISM_AUTODETECT": "ON"
      }
    },
    {
      "name": "nocubism",
      "displayName": "Debug + 完全无 Cubism 后端",
      "description": "验证 Live2D 后端是真正可选的：不启用桩也不启用真实 SDK。",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PPET_WITH_CUBISM": "OFF",
        "PPET_WITH_CUBISM_STUB": "OFF",
        "PPET_CUBISM_AUTODETECT": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASAN/UBSAN（桩后端）",
      "description": "AddressSanitizer + UndefinedBehaviorSanitizer，仅用于健壮性回归，不产出交付程序。仅 GCC/Clang 可用。",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "PPET_WITH_CUBISM": "OFF",
        "PPET_WITH_CUBISM_STUB": "ON",
        "PPET_CUBISM_AUTODETECT": "OFF"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "description": "vcpkg manifest 模式基础（报告 4.2.1）：需先设置环境变量 VCPKG_ROOT 指向 vcpkg 根目录。",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "vcpkg-stub",
      "displayName": "Release + 桩 + vcpkg 依赖",
      "description": "vcpkg 一键装 GLFW/GLEW/Qt6/nlohmann，用桩后端构建。需 export VCPKG_ROOT。",
      "inherits": ["stub", "vcpkg-base"]
    },
    {
      "name": "vcpkg-cubism",
      "displayName": "Release + 真实 Cubism SDK + vcpkg 依赖",
      "description": "vcpkg 一键装依赖 + 真实 Cubism SDK。需 export VCPKG_ROOT 与 SDK。",
      "inherits": ["cubism", "vcpkg-base"]
    },
    {
      "name": "vcpkg-nocubism",
      "displayName": "Debug + 无 Cubism + vcpkg 依赖",
      "description": "vcpkg 一键装依赖 + 完全无 Cubism 后端。需 export VCPKG_ROOT。",
      "inherits": ["nocubism", "vcpkg-base"]
    }
  ],

  "buildPresets": [
    {
      "name": "stub",
      "displayName": "构建 stub",
      "configurePreset": "stub",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "cubism",
      "displayName": "构建 cubism",
      "configurePreset": "cubism",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "nocubism",
      "displayName": "构建 nocubism",
      "configurePreset": "nocubism",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "asan",
      "displayName": "构建 asan",
      "configurePreset": "asan",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "vcpkg-stub",
      "displayName": "构建 vcpkg-stub",
      "configurePreset": "vcpkg-stub",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "vcpkg-cubism",
      "displayName": "构建 vcpkg-cubism",
      "configurePreset": "vcpkg-cubism",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "vcpkg-nocubism",
      "displayName": "构建 vcpkg-nocubism",
      "configurePreset": "vcpkg-nocubism",
      "configuration": "Debug",
      "jobs": 4
    }
  ],

  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "stub",
      "displayName": "测试 stub",
      "inherits": "base",
      "configurePreset": "stub",
      "configuration": "Release"
    },
    {
      "name": "cubism",
      "displayName": "测试 cubism",
      "inherits": "base",
      "configurePreset": "cubism",
      "configuration": "Release"
    },
    {
      "name": "nocubism",
      "displayName": "测试 nocubism",
      "inherits": "base",
      "configurePreset": "nocubism",
      "configuration": "Debug"
    },
    {
      "name": "asan",
      "displayName": "测试 asan",
      "description": "preset v2 不支持用例过滤；CI 中通过 ctest -E 排除两个已知的 Qt GUI 内存泄漏用例。",
      "inherits": "base",
      "configurePreset": "asan",
      "configuration": "Debug"
    },
    {
      "name": "vcpkg-stub",
      "displayName": "测试 vcpkg-stub",
      "inherits": "base",
      "configurePreset": "vcpkg-stub",
      "configuration": "Release"
    },
    {
      "name": "vcpkg-cubism",
      "displayName": "测试 vcpkg-cubism",
      "inherits": "base",
      "configurePreset": "vcpkg-cubism",
      "configuration": "Release"
    },
    {
      "name": "vcpkg-nocubism",
      "displayName": "测试 vcpkg-nocubism",
      "inherits": "base",
      "configurePreset": "vcpkg-nocubism",
      "configuration": "Debug"
    }
  ]
}
